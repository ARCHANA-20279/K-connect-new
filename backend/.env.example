PORT=5000
MONGO_URI=your_mongodb_atlas_connection_string_here
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000
# Required to send password reset codes. Create a sending-only key in Resend.
RESEND_API_KEY=your_resend_api_key
# Must be an address on a domain verified in Resend, e.g. K-Connect <no-reply@yourdomain.com>
EMAIL_FROM=K-Connect <noreply@your-verified-domain.example>
